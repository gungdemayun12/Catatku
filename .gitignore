# The whole IDE folder is per-machine state. Individual files above are kept
# for older checkouts; this line covers everything else (vcs.xml, markdown.xml).
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release signing material. The keystore holds the app's private signing key
# and the build file carries its passwords, so neither belongs in version
# control. Supply them from CI secrets or a local-only file instead.
*.jks
*.keystore
firebase-debug.log
/keystore.properties

# Firebase config carries an API key; supply it locally (see README) instead
# of committing it, so GitHub secret scanning stays clean.
app/google-services.json

# Build output and binaries
*.apk
*.aab
*.ap_
/tmpjar
/tools
