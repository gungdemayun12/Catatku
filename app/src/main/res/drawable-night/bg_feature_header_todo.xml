<?xml version="1.0" encoding="utf-8"?>
<!-- Soft vertical indigo ramp used by the to-do screen header (dark). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/grad_todo_end"
        android:startColor="@color/grad_todo_start"
        android:type="linear" />
    <corners android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp" />
</shape>