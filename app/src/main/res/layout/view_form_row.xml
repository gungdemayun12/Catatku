<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared row used for "label above value" pickers (deadline, category, wallet, ...).

  Alignment rules:
  * the icon sits in a fixed 40dp square that the row centres, so all pickers
    line their icons up in one column;
  * the label and the value are on their own centre-aligned block, and both use
    includeFontPadding="false" so the two lines are evenly spaced and the block's
    visual centre matches the icon's centre;
  * the value line is single-line + ellipsized instead of growing into the
    chevron, and there are no negative margins, so nothing can overlap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_square">

        <ImageView
            android:id="@+id/rowIcon"
            style="@style/Widget.CatatKu.Icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tag" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="1"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="11sp"
            tools:text="Deadline" />

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="14sp"
            tools:text="19 Nov 2026" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
