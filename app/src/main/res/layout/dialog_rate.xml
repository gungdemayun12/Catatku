<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/rateSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/color_on_surface"
        android:textSize="15sp"
        tools:text="1 USD = ? IDR" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rateLayout"
        style="@style/Widget.CatatKu.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/rate_hint"
        app:suffixText="IDR">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rateEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/rateHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/rate_required_hint"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="10sp" />
</LinearLayout>
