<?xml version="1.0" encoding="utf-8"?>
<!-- One deposit in a goal's history: amount on the right, when it happened on
     the left, optional note underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="14dp"
        android:layout_height="14dp">

        <ImageView
            android:id="@+id/entryIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_savings"
            app:tint="@color/color_on_surface_variant" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="12sp"
            tools:text="22 Nov 2026" />

        <TextView
            android:id="@+id/entryNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:maxLines="1"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Gajian"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/entryAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:textColor="@color/income"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        tools:text="+Rp 500.000" />
</LinearLayout>
