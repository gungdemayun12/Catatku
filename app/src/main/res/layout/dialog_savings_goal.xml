<?xml version="1.0" encoding="utf-8"?>
<!--
    Create / edit a savings goal.

    Kept to four decisions: what it is called, how much it costs, by when
    (optional), and how much is already set aside. Anything more would make
    creating a goal feel like paperwork, and the whole point is that the user
    starts saving in the next thirty seconds.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/titleLayout"
            style="@style/Widget.CatatKu.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/goal_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/titleEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/targetLayout"
            style="@style/Widget.CatatKu.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_target_amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/targetEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/initialLayout"
            style="@style/Widget.CatatKu.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/goal_initial_amount"
            android:visibility="gone"
            app:helperText="@string/goal_initial_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/initialEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/goal_type_label"
            android:textAppearance="@style/TextAppearance.CatatKu.Label" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/typeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/typeOther"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/goal_type_other" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeGadget"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_type_gadget" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeTravel"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_type_travel" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeEmergency"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_type_emergency" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeHome"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_type_home" />

            <com.google.android.material.chip.Chip
                android:id="@+id/typeEducation"
                style="@style/Widget.CatatKu.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/goal_type_education" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/deadlineSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/goal_deadline_switch"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deadlineButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/goal_no_deadline"
            android:textSize="13sp"
            android:visibility="gone"
            app:icon="@drawable/ic_calendar"
            app:iconSize="17dp" />
    </LinearLayout>
</ScrollView>
