<?xml version="1.0" encoding="utf-8"?>
<!--
    Savings goals list.

    The screen is arranged around one question: "am I getting closer?" So the
    header is not a filter bar but a single line — total saved against total
    targeted — and the list below is ordered by progress rather than by name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".finance.SavingsGoalsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingTop="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_back"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:text="@string/goal_title"
            android:textColor="@color/color_on_surface"
            android:textSize="21sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add"
            app:icon="@drawable/ic_add"
            app:iconSize="18dp" />
    </LinearLayout>

    <!--
        Hero summary. Saving is slow, so the screen leads with the accumulated
        number rather than with a list of things still undone: it is the one
        figure that can only go up.
    -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CatatKu.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/color_primary_container"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/heroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:text="@string/goal_hero_label"
                android:textColor="@color/color_on_primary_container"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/heroSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="1"
                android:textColor="@color/color_on_primary_container"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                tools:text="Rp 4.250.000" />

            <TextView
                android:id="@+id/heroTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="1"
                android:textColor="@color/color_on_primary_container"
                android:textSize="11sp"
                tools:text="dari Rp 12.000.000 di 3 target" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/heroProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:trackColor="@color/color_surface_variant"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp"
                tools:progress="35" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="10sp"
        tools:text="3 target aktif" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
