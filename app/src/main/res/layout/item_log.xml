<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity feed row. Icon and text share one centre line: the icon lives in a
  fixed 40dp circle the row centres, and every line has font padding off so the
  two-line block's visual centre matches the icon's centre. The timestamp is
  centre-aligned against the block for the same reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/icon"
            style="@style/Widget.CatatKu.Icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_info" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="14sp"
            tools:text="Finish the weekly report" />

        <TextView
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="11sp"
            tools:text="Completed" />
    </LinearLayout>

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="1"
        android:maxWidth="120dp"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="10sp"
        tools:text="19 Nov, 10:24" />
</LinearLayout>
