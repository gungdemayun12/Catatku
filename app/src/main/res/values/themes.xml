<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        The real theme body lives in an unqualified name so that the API 27
        variants (values-v27, values-night-v27) can extend it and add only the
        one attribute they need. A style in a resource qualifier replaces its
        same-named base definition rather than merging with it, so the shared
        attributes must live somewhere the variant can inherit from.
    -->
    <style name="Theme.CatatKu.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorOnTertiary">@color/color_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/color_on_tertiary_container</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>

        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_outline_variant</item>
        <item name="colorSurfaceContainer">@color/color_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface_container_high</item>

        <item name="materialCardViewStyle">@style/Widget.CatatKu.Card</item>
        <item name="materialButtonStyle">@style/Widget.CatatKu.Button</item>
        <item name="textInputStyle">@style/Widget.CatatKu.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.CatatKu.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.CatatKu.Fab</item>
        <item name="chipStyle">@style/Widget.CatatKu.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CatatKu.Dialog</item>

        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Variants add per-API attributes on top of the shared body. -->
    <style name="Base.Theme.CatatKu" parent="Theme.CatatKu.Base" />

    <style name="Theme.CatatKu" parent="Base.Theme.CatatKu" />

    <!-- Splash body split out for the same reason as the theme body above:
         the API 27 variants must be able to extend it. -->
    <style name="Theme.CatatKu.Splash.Base" parent="Theme.CatatKu">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="Theme.CatatKu.Splash" parent="Theme.CatatKu.Splash.Base" />

    <style name="Theme.CatatKu.TransparentToolbar" parent="Theme.CatatKu">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/color_background</item>
    </style>

    <!-- Auth screens paint their own graded header behind the status bar. -->
    <style name="Theme.CatatKu.Auth" parent="Theme.CatatKu">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dialog surface: generous radius and a calm, elevated look. -->
    <style name="ThemeOverlay.CatatKu.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CatatKu.Dialog</item>
        <item name="colorSurface">@color/color_surface</item>
    </style>

    <style name="ShapeAppearance.CatatKu.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.CatatKu.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardMaxElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.CatatKu.Card.Surface" parent="Widget.CatatKu.Card">
        <item name="cardBackgroundColor">@color/color_surface_container</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Flat card that still gets a hairline for grouping dense lists. -->
    <style name="Widget.CatatKu.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_outline_variant</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Highlighted chart/statistics card. -->
    <style name="Widget.CatatKu.Card.Chart" parent="Widget.CatatKu.Card">
        <item name="cardElevation">3dp</item>
        <item name="cardMaxElevation">3dp</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="Widget.CatatKu.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">17dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">1dp</item>
    </style>

    <style name="Widget.CatatKu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">17dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/color_outline_variant</item>
    </style>

    <style name="Widget.CatatKu.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.CatatKu.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="android:textColorHint">@color/color_on_surface_variant</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="hintEnabled">true</item>
        <item name="expandedHintEnabled">true</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.CatatKu.Helper</item>
        <item name="errorTextAppearance">@style/TextAppearance.CatatKu.Helper</item>
        <item name="counterTextAppearance">@style/TextAppearance.CatatKu.Helper</item>
    </style>

    <style name="TextAppearance.CatatKu.Helper" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.CatatKu.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_surface</item>
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CatatKu.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.CatatKu.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_container</item>
    </style>

    <style name="Widget.CatatKu.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CatatKu.Fab</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="tint">@color/color_on_primary</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="ShapeAppearance.CatatKu.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Widget.CatatKu.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">14dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/color_outline_variant</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">12sp</item>
        <!--
            Tighter internal padding so the five status filters (All / Today / Upcoming /
            Overdue / Done) all fit on a 1080px-wide screen. Previously "Done" sat
            off-screen and the history tab was easy to miss entirely. A Material Chip
            ignores android:padding* and uses its own chipStartPadding/chipEndPadding.
        -->
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
    </style>

    <style name="Widget.CatatKu.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipCornerRadius">14dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/color_outline_variant</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.CatatKu.Segmented" parent="">
        <item name="android:textSize">13sp</item>
    </style>

    <!--
        The one badge shape used across the to-do list. Both the status badge
        (Open / In progress / Done) and the priority badge (Low / Medium / High)
        use it, so the two pills in the trailing column are the same size and
        line up perfectly. Tint is applied at runtime (see TodoAdapter), because
        the background is a plain pill that only needs a solid colour.
    -->
    <style name="Widget.CatatKu.Badge" parent="">
        <item name="android:background">@drawable/bg_badge_pill</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.CatatKu.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.CatatKu.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.CatatKu.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.CatatKu.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.CatatKu.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <style name="Widget.CatatKu.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/color_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.CatatKu.Headline</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.CatatKu.Body</item>
    </style>

    <style name="Widget.CatatKu.InfoRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!--
        ===================== Icon / text alignment =====================

        Every row that puts a small icon or dot next to a line of text uses the
        same three parts, so nothing can drift out of line:

          • {@code Widget.CatatKu.IconFrame} wraps the icon in a fixed square.
            The square is the alignment anchor: the row centres the square, and
            because every square in a group has the same size the icons form one
            straight vertical column regardless of the drawing inside them.

          • {@code Widget.CatatKu.Icon} is the drawing itself, always
            gravity="center" in its frame, so a 16dp glyph and a 22dp glyph both
            sit in the middle of their frame instead of hugging the top edge.

          • {@code TextAppearance.CatatKu.MetaLine} is the small caption used
            beside icons. fontPadding is off (it adds invisible space above the
            cap height on some devices) and lineSpacingExtra is 0, so the text
            box is exactly as tall as its glyphs. That is what makes
            "✓ Finished tasks move to the Done tab." share a centre line with
            a check mark instead of sitting below it.

        The text appearances below follow the same rule: no extra font padding
        and no extra line spacing, which keeps every baseline predictable when
        a TextView is centred next to an ImageView.
    -->
    <style name="Widget.CatatKu.IconFrame" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_icon_square</item>
    </style>

    <style name="Widget.CatatKu.Icon" parent="">
        <item name="android:layout_width">19dp</item>
        <item name="android:layout_height">19dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <!--
        Inline icon + text pair (pill, meta line, legend, section caption).
        Centres icon and text on the same line with a fixed drawable size, so
        the icon never pushes the first line of text off-baseline.
    -->
    <style name="Widget.CatatKu.MetaLine" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <!--
        Pill with a leading icon, used on the coloured hero headers.

        The icon is an inline drawable, so Android centres it inside the text
        line box rather than inside the pill. Two things must therefore be true
        for the pair to look level:

          • drawableSize is set explicitly. A vector's intrinsic size (24dp)
            is taller than the 11sp line, so an unsized drawable gets clipped
            and drags the text baseline around.
          • includeFontPadding is false. The extra top/bottom padding some
            fonts carry is asymmetric, which lifts the text off the icon's
            centre line by a couple of pixels.

        13dp keeps the glyph optically the same weight as 11sp capitals while
        staying inside the pill's 5dp vertical padding.
    -->
    <style name="Widget.CatatKu.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill_dark</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!--
        Inline trailing-arrow link. The caller sets app:drawableSize so the
        chevron matches the 11sp line height and sits on the text's centre line
        instead of hanging below it.
    -->
    <style name="Widget.CatatKu.TextLink" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>

</resources>
