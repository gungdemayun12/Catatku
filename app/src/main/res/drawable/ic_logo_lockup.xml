<?xml version="1.0" encoding="utf-8"?>
<!--
    Self-contained brand lockup for the auth headers.

    It is deliberately ONE drawable with no nested references: the previous
    version stacked a translucent white badge on top of the teal gradient
    header and then tinted a multi-colour mark white, which is why nothing
    showed up on the login/register screens. Here the disc is solid white and
    the mark itself carries the brand colour, so it always reads no matter what
    is behind it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Soft halo so the lockup lifts off the gradient header. -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M24,1.5C11.57,1.5 1.5,11.57 1.5,24S11.57,46.5 24,46.5 46.5,36.43 46.5,24 36.43,1.5 24,1.5z" />
    <!-- Solid disc. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,4.5C13.23,4.5 4.5,13.23 4.5,24S13.23,43.5 24,43.5 43.5,34.77 43.5,24 34.77,4.5 24,4.5z" />
    <!-- Brand tick. -->
    <path
        android:fillColor="#0E7C6B"
        android:pathData="M20.9,32.1L12.4,23.6l3.1,-3.1 5.4,5.4 11.6,-11.6 3.1,3.1z" />
    <!-- Amber accent dot: the "recorded" spark. -->
    <path
        android:fillColor="#E08A0B"
        android:pathData="M35,13.6m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
</vector>
