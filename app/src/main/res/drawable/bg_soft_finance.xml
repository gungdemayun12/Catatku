<?xml version="1.0" encoding="utf-8"?>
<!-- Soft brand-tinted panel used by the finance screens (summary blocks, settings rows). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/surface_finance_soft"
        android:startColor="@color/color_surface"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="@color/color_outline_variant" />
</shape>
