<?xml version="1.0" encoding="utf-8"?>
<!-- Flat rounded panel for the home screen tip row. Deliberately has no
     elevation/shadow: the previous MaterialCardView cast a soft blur outside its
     rounded bounds in both light and dark mode, which the design does not want. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/color_surface_container" />
    <stroke android:width="1dp" android:color="@color/color_outline_variant" />
    <corners android:radius="20dp" />
</shape>
